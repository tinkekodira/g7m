{
  "name": "g7m",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform strength training app \u2014 3D anatomy explorer and offline-first workout logger.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter @g7m/web dev",
    "build": "pnpm --filter @g7m/web build",
    "preview": "pnpm --filter @g7m/web preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "mobile:sync": "pnpm --filter @g7m/mobile sync",
    "desktop:dev": "pnpm --filter @g7m/desktop dev",
    "desktop:build": "pnpm --filter @g7m/desktop build",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:status": "supabase migration list --linked",
    "sync-rules": "vitest run -u packages/db/src/schema/sync-rules.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "supabase": "2.116.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
