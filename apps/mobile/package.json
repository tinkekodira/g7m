{
  "name": "@g7m/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell for iOS and Android. Thin: native config, icons, splash, plugins.",
  "scripts": {
    "build:web": "pnpm --filter @g7m/web build",
    "assets": "capacitor-assets generate --ios --android --iosProject ios/App --androidProject android --assetPath assets --iconBackgroundColor '#1F1E1D' --iconBackgroundColorDark '#1F1E1D' --splashBackgroundColor '#F5F3EE' --splashBackgroundColorDark '#1F1E1D' && node scripts/web-icons.mjs",
    "sync": "pnpm build:web && cap sync",
    "copy": "pnpm build:web && cap copy",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "pnpm sync && cap run ios",
    "run:android": "pnpm sync && cap run android",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "sharp": "^0.34.4"
  }
}
