# ---------------------------------------------------------------------------
# g7m environment
#
# Copy to `.env.local` and fill in real values:   cp .env.example .env.local
# `.env*.local` is gitignored. `.env.example` is committed and must only ever
# contain dummy values.
#
# ANYTHING PREFIXED `VITE_` IS COMPILED INTO THE CLIENT BUNDLE AND IS PUBLIC.
# Treat every VITE_ value as if it were printed on the app's About screen,
# because effectively it is.
# ---------------------------------------------------------------------------

# --- Supabase (client-side, public by design) ------------------------------

# Project REST endpoint. Found in Supabase dashboard > Project Settings > API.
# Must be an EU-region project (see DECISIONS.md ADR-0002).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# The anon/publishable key. Public by design and safe to ship: it grants only
# what Row Level Security allows. RLS is the security boundary, not this key.
# If RLS is off on a table, this key reads the whole table — so RLS is not
# optional.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy.dummy"

# --- PowerSync (client-side, public by design) -----------------------------

# PowerSync instance URL. The client authenticates with a Supabase JWT, so the
# URL alone grants nothing.
VITE_POWERSYNC_URL="https://your-instance.powersync.journeyapps.com"

# --- Feature flags (client-side) -------------------------------------------

# Phase 6, layer 2. When "false" the generator uses the deterministic rules
# engine only and never calls the Edge Function. Default off until Phase 6.
VITE_FEATURE_CLAUDE_GENERATOR="false"

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — NEVER PUT THESE IN THIS FILE, IN .env.local, OR IN ANY
# FILE UNDER THIS REPO.
#
# They live in Supabase Edge Function secrets and are set from the CLI:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# Listed here as documentation only. The pre-commit hook in .githooks/ and the
# gitleaks CI job will both reject a commit that contains a real one.
#
#   ANTHROPIC_API_KEY          Claude API key. Powers the Phase 6 generator
#                              variety layer. Client never sees it.
#   SUPABASE_SERVICE_ROLE_KEY  Bypasses RLS entirely. Full read/write on every
#                              user's data. Guard it like a root password.
# ---------------------------------------------------------------------------
