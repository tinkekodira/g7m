<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of g7m leaves the phone through Android backup, to Google Drive or to
    a new phone (Android 12+; `allowBackup="false"` covers 11 and older).

    The app's data dir holds the WebView's storage: the sign-in session, and the
    PowerSync database with its upload queue and sync checkpoint. A copy of the
    session restored elsewhere is a login nobody typed, and a restored database
    is an old snapshot that thinks it is current. The account lives in Supabase;
    on a new phone you sign in and it syncs down. ADR-0192.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
