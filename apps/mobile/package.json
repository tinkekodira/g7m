{
  "name": "@g7m/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell for iOS and Android. Thin: native config, icons, splash, plugins.",
  "scripts": {
    "build:web": "pnpm --filter @g7m/web build",
    "assets": "capacitor-assets generate --ios --android --iosProject ios/App --androidProject android --assetPath assets --iconBackgroundColor \"#101214\" --iconBackgroundColorDark \"#101214\" --splashBackgroundColor \"#F3F5F0\" --splashBackgroundColorDark \"#202429\" && node scripts/web-icons.mjs",
    "sync": "pnpm build:web && cap sync",
    "copy": "pnpm build:web && cap copy",
    "capacitor:copy:after": "node scripts/strip-source-maps.mjs",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "pnpm sync && cap run ios",
    "run:android": "pnpm sync && cap run android",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "sharp": "^0.34.4"
  }
}
