# Normalise line endings so Windows/macOS/Linux clones agree.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# --- Git LFS ---
# Set up BEFORE the first binary lands. Retrofitting LFS rewrites history.
# An 8 MB anatomy GLB committed normally lives in the repo forever, in every
# clone, even after deletion.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text

# Except the exercise demonstration loops (ADR-0102). They are 170–190 KB,
# smaller than the transparent WebPs beside them, and every build needs them —
# but no workflow checks LFS out, so through LFS the build would bundle the
# pointer files and no loop would play. Committed like the equipment icons.
apps/web/src/assets/demos/*.mp4 -filter -diff -merge -text

# Lockfile: generated, don't blow up diffs in review.
pnpm-lock.yaml -diff linguist-generated=true
